<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ScreenshotAnnotator.Markup"
        x:Class="ScreenshotAnnotator.Views.ThirdPartyNoticesWindow"
        Title="{local:Localize Menu_ThirdPartyNotices}"
        Width="720"
        Height="640"
        MinWidth="480"
        MinHeight="360"
        Background="#1E1E1E"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#E6E6E6"/>
    </Style>
    <Style Selector="Button.close">
      <Setter Property="Background" Value="#3C3C3C"/>
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
  </Window.Styles>
  <DockPanel Margin="16">
    <Button x:Name="OkButton"
            DockPanel.Dock="Bottom"
            Content="{local:Localize Button_OK}"
            Classes="close"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            Margin="0,12,0,0"
            Click="OkButton_Click"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="DocumentHost" Spacing="0"/>
    </ScrollViewer>
  </DockPanel>
</Window>
